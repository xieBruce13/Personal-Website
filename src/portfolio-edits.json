    "b355d47e1d8f06e484229342": {
      "original": "I chose one useful recommendation over another dashboard.",
      "text": "We stopped adding charts and designed the agent to combine multiple metrics into advice users could act on right away. The focus shifted from “What’s my heart rate variability (HRV)?” to “What should I adjust today?”",
      "size": null
    },
    "8da6b8b9c750f8b73f3b31b8": {
      "original": "(Proposed)",
      "text": "",
      "size": null
    },
