      "text": "Direct To User",
      "size": 41
    },
    "1dfeced8bcf7e4af11e30837": {
      "original": "I brought guidance into iMessage, where people already reply.",
      "text": "Health advice is time-sensitive. People are unlikely to open a new app every time their readings change, so we chose to send recommendations by text. A text message has limited space, but it can reach someone at the moment the advice matters.",
      "size": 17
    },
    "c46264348f8150ce944f05b5": {
      "original": "The whole",
      "text": "Context of the",
      "size": 41
    },
    "166df2c01c9ebc98ff6ed363": {
      "original": "day.",
      "text": "whole day",
      "size": 41
    },
    "5cda0fb235135313195af7ee": {
      "original": "I combined baselines, calendar, goals and history to make advice relevant.",
      "text": "A poor night’s sleep has different implications on a day off than it does two hours before a job interview. The agent connects to the user’s calendar and considers their schedule alongside their physiological data, profile, and past conversations to decide whether a recommendation makes sense in that moment.",
      "size": 17
    },
